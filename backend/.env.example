# ============================================================
# ProtoPatch — Environment Configuration
# ============================================================

# --- Google Gemini API (REQUIRED) ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# --- GitHub Automation (OPTIONAL - needed for automatic PR opening) ---
# Create a Personal Access Token (PAT) at: https://github.com/settings/tokens
# Required scopes: repo (full control of repositories)
GITHUB_TOKEN=your_github_token_here
# --- Default Target Repository for ScreenToPatch (OPTIONAL) ---
# The GitHub repository URL ProtoPatch will open PRs against
DEFAULT_REPO_URL=

# --- Django Settings ---
DJANGO_SECRET_KEY=protopatch-dev-secret-key-0192837465-iqoo-hackathon
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Whisper Model (OPTIONAL - for local speech-to-text) ---
# Options: tiny (39MB), base (74MB), small (244MB), medium (769MB)
WHISPER_MODEL_SIZE=tiny

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000